---

<div class="toggle-track" id="theme-toggle">
  <div class="toggle-moon">
    <span role="img" aria-label="Enable Dark Mode"> 🌛</span>
  </div>
  <div class="toggle-sun">
    <span role="img" aria-label="Enable Light Mode"> ☀️</span>
  </div>
  <div class="toggle-thumb"></div>
</div>
<script is:inline>
  const toggle = document.querySelector('#theme-toggle');

  // Apply a theme and keep the toggle thumb (`.toggled`) in sync with it.
  function applyTheme(dark) {
    document.body.className =
      document.body.className.replace(/(light|dark)-mode/, '').trim() +
      (dark ? ' dark-mode' : ' light-mode');
    if (toggle) {
      toggle.classList.toggle('toggled', dark);
    }
  }

  if (toggle) {
    toggle.addEventListener('click', function () {
      const dark = window.localStorage.getItem('darkMode') !== 'true';
      window.localStorage.setItem('darkMode', String(dark));
      applyTheme(dark);
    });
  }

  applyTheme(window.localStorage.getItem('darkMode') === 'true');
</script>
